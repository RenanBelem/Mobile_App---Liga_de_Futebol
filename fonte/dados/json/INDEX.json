{
  "application_data_structure": {
    "title": "Liga AF de Futebol - JSON Data Structure",
    "version": "1.0.0",
    "description": "Complete normalized data structure for a football league management system",
    "last_updated": "2026-05-21",
    "total_files": 11,
    "files_overview": [
      {
        "filename": "ligas.json",
        "records": 2,
        "description": "Ligas principais - Estruturas organizacionais de alto nível",
        "primary_key": "id",
        "relationships": ["has_many: tournaments", "has_many: teams"]
      },
      {
        "filename": "torneios.json",
        "records": 4,
        "description": "Torneios e competições dentro das ligas",
        "primary_key": "id",
        "foreign_keys": ["league_id"],
        "relationships": ["belongs_to: leagues", "has_many: matches", "has_many: phases"]
      },
      {
        "filename": "times.json",
        "records": 6,
        "description": "Times participantes",
        "primary_key": "id",
        "foreign_keys": ["league_id"],
        "relationships": ["belongs_to: leagues", "has_many: players", "has_many: matches"]
      },
      {
        "filename": "jogadores.json",
        "records": 10,
        "description": "Jogadores / Elenco dos times",
        "primary_key": "id",
        "foreign_keys": ["team_id"],
        "relationships": ["belongs_to: teams", "has_many: match_events"]
      },
      {
        "filename": "fases.json",
        "records": 10,
        "description": "Fases/Rodadas/Turnos dos torneios",
        "primary_key": "id",
        "foreign_keys": ["tournament_id"],
        "relationships": ["belongs_to: tournaments", "has_many: matches"]
      },
      {
        "filename": "partidas.json",
        "records": 11,
        "description": "Partidas/Jogos com placar, data e status",
        "primary_key": "id",
        "foreign_keys": ["tournament_id", "phase_id", "home_team_id", "away_team_id"],
        "relationships": ["belongs_to: tournaments", "belongs_to: phases", "has_many: match_events"]
      },
      {
        "filename": "eventos_partida.json",
        "records": 18,
        "description": "Eventos dentro de partidas - gols, assistências, cartões",
        "primary_key": "id",
        "foreign_keys": ["match_id", "player_id", "team_id", "assist_by_player_id"],
        "relationships": ["belongs_to: matches", "belongs_to: players"]
      },
      {
        "filename": "standings.json",
        "records": 8,
        "description": "Tabela de classificação dos torneios",
        "primary_key": "id",
        "foreign_keys": ["tournament_id", "team_id"],
        "relationships": ["belongs_to: tournaments", "belongs_to: teams"],
        "unique_constraints": ["(tournament_id, team_id)"]
      },
      {
        "filename": "podios.json",
        "records": 2,
        "description": "Pódios/Campeões dos torneios finalizados",
        "primary_key": "id",
        "foreign_keys": ["tournament_id"],
        "relationships": ["belongs_to: tournaments"],
        "unique_constraints": ["tournament_id"]
      },
      {
        "filename": "midias.json",
        "records": 8,
        "description": "Galeria de fotos e vídeos dos torneios",
        "primary_key": "id",
        "foreign_keys": ["tournament_id", "match_id (optional)"],
        "relationships": ["belongs_to: tournaments"]
      },
      {
        "filename": "usuarios.json",
        "records": 8,
        "description": "Usuários do sistema com diferentes permissões",
        "primary_key": "id",
        "foreign_keys": ["team_id (optional)"],
        "relationships": ["belongs_to: teams (optional)"],
        "unique_constraints": ["email"]
      }
    ],
    "data_summary": {
      "leagues": 2,
      "tournaments": 4,
      "teams": 6,
      "players": 10,
